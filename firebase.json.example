{
  "firestore": {
    "database": "myprofilewebapp",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".output/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [{ "source": "/favicon.ico", "destination": "/favicon.svg", "type": 301 }],
    "rewrites": [
      {
        "source": "/mcp",
        "function": { "functionId": "chatgptAdminMcp", "region": "us-central1" }
      },
      {
        "source": "/mcp/**",
        "function": { "functionId": "chatgptAdminMcp", "region": "us-central1" }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      {
        "source": "/.well-known/oauth-protected-resource/mcp",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      {
        "source": "/authorize",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      {
        "source": "/authorize/**",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      {
        "source": "/token",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      {
        "source": "/register",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      {
        "source": "/revoke",
        "function": { "functionId": "profileAdminOAuth", "region": "us-central1" }
      },
      { "source": "**", "destination": "/_shell.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  }
}
